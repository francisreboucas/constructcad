prop-attached-to = 上部のアタッチ先
tx-wall-attach = 壁の上部をアタッチ

# Plugins
group-plugins = プラグイン
action-plugins = プラグイン…
cmd-desc-plugins = インストール済みのプラグインを管理 (オン/オフ、ファイルアクセスの許可、削除) し、コミュニティのインデックスからプラグインをインストールします。
action-plugin-commands = プラグインコマンド
cmd-desc-plugin-commands = インストール済みプラグインのコマンドを実行します: そのフォームがコマンドパレットに開きます。
dlg-plugins = プラグイン
plug-tab-installed = インストール済み ({ $count })
plug-tab-available = 利用可能
plug-search = プラグインを検索
plug-folder = プラグインフォルダ: { $path }
plug-no-folder = プラグインフォルダがありません: 環境設定 → ファイルの場所 で設定してください。
plug-none-installed = インストール済みのプラグインはありません。「利用可能」から探してください。
plug-pick = リストからプラグインを選択
plug-version = バージョン { $version }
plug-by = 作成者: { $authors }
plug-license = ライセンス: { $license }
plug-homepage = プラグインのページ
plug-error = 読み込めませんでした: { $message }
plug-enabled = オン
plug-files = ファイルの読み書きを許可
plug-files-hint = このプラグインはファイルのインポート、エクスポート、保存を求めています。許可しない場合、それを行うコマンドは拒否されます。
plug-commands = コマンド
plug-no-commands = なし: プラグインがオフか、読み込めませんでした。
plug-remove = 削除
plug-removed = { $name } を削除しました。
plug-remove-failed = { $name } を削除できませんでした: { $message }
plug-reload = プラグインを再読み込み
plug-refresh = 更新
plug-loading = プラグインのインデックスを読み込み中…
plug-index-failed = プラグインのインデックスを読み込めませんでした: { $message }
plug-index-empty = インデックスにプラグインがありません。
plug-incompatible = より新しいバージョンの ConstructCAD が必要です。
plug-needs-app = ConstructCAD { $version } 以降が必要です (現在は { $current })。
plug-install = インストール
plug-update = { $version } に更新
plug-installed-version = インストール済み ({ $version })
plug-installing = { $name } をインストール中…
plug-installed-ok = { $name } { $version } をインストールしました。
plug-install-failed = { $name } をインストールできませんでした: { $message }
plug-review = プラグインは ConstructCAD ではなく各作者が作成したものです。制限付きで実行され、ネットワークにはアクセスできませんが、インストールする前にプラグインの説明を確認してください。
plug-menu-none = プラグインコマンドはありません。プラグインウィンドウからプラグインをインストールしてください。
pref-plugin-folder = プラグインフォルダ
pref-plugin-folder-hint = プラグインはプラグインフォルダにインストールされ、そこから読み込まれます。未設定の場合は { $path } です。
