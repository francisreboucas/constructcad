// Showcase project for the README screenshots, built with engine commands only.
// ccad --lang en --save-as examples/showcase.ccad script examples/showcase.ccmacro
// Scripts have no variables: later steps name elements, types and views by id,
// which a fresh session assigns in order (tests/commands.rs runs this script).
{"command": "project_info_set", "args": {"name": "Showcase house", "author": "ConstructCraft"}}
// Existing house (walls 90-94): 9 x 5 m, with an old partition to demolish.
{"command": "wall_create", "args": {"start": [0, 0], "end": [9, 0], "type": 3, "height": 2.6}}
{"command": "wall_create", "args": {"start": [9, 0], "end": [9, 5], "type": 3, "height": 2.6}}
{"command": "wall_create", "args": {"start": [9, 5], "end": [0, 5], "type": 3, "height": 2.6}}
{"command": "wall_create", "args": {"start": [0, 5], "end": [0, 0], "type": 3, "height": 2.6}}
{"command": "wall_create", "args": {"start": [5.5, 0], "end": [5.5, 5], "type": 5, "height": 2.6}}
{"command": "wall_create", "args": {"start": [3, 0], "end": [3, 5], "type": 5, "height": 2.6}}
// Extension: a bedroom to the east and a wing to the north ending in an arc wall.
{"command": "wall_create", "args": {"start": [9, 0], "end": [12, 0], "type": 3, "height": 2.6}}
{"command": "wall_create", "args": {"start": [12, 0], "end": [12, 10], "type": 3, "height": 2.6}}
{"command": "wall_create", "args": {"start": [12, 10], "end": [7, 10], "mid": [9.5, 11.6], "type": 3, "height": 2.6}}
{"command": "wall_create", "args": {"start": [7, 10], "end": [7, 5], "type": 3, "height": 2.6}}
{"command": "wall_create", "args": {"start": [9, 5], "end": [12, 5], "type": 3, "height": 2.6}}
{"command": "wall_create", "args": {"start": [9.5, 5], "end": [9.5, 7.5], "type": 5, "height": 2.6}}
{"command": "wall_create", "args": {"start": [9.5, 7.5], "end": [12, 7.5], "type": 5, "height": 2.6}}
// Renovation: the old house is existing, its old partition is demolished.
{"command": "elements_phase_set", "args": {"ids": [90, 91, 92, 93, 94, 95], "created": 81}}
{"command": "elements_demolish", "args": {"ids": [95], "phase": 82}}
// Doors and windows.
{"command": "door_create", "args": {"point": [1.6, 0.5], "type": 7}}
{"command": "door_create", "args": {"point": [5, 3.6], "type": 6}}
{"command": "door_create", "args": {"point": [9.5, 1.2], "type": 6, "flip_hand": true}}
{"command": "door_create", "args": {"point": [8.2, 5.5], "type": 6}}
{"command": "door_create", "args": {"point": [9, 6.6], "type": 6}}
{"command": "window_create", "args": {"point": [4.2, -0.5], "type": 9}}
{"command": "window_create", "args": {"point": [-0.5, 2.5], "type": 9}}
{"command": "window_create", "args": {"point": [7.2, -0.5], "type": 8}}
{"command": "window_create", "args": {"point": [10.5, -0.5], "type": 8}}
{"command": "window_create", "args": {"point": [12.5, 2.5], "type": 8}}
{"command": "window_create", "args": {"point": [9.5, 12]}}
{"command": "window_create", "args": {"point": [6.5, 8]}}
{"command": "window_create", "args": {"point": [12.5, 9]}}
// Floor, hip roof over the L-shaped footprint (its planes come from the straight skeleton).
{"command": "floor_create", "args": {"boundary": [[-0.075, -0.075], [12.075, -0.075], [12.075, 10.016], [11.742, 10.570], [11.293, 11.034], [10.750, 11.384], [10.142, 11.601], [9.500, 11.675], [8.858, 11.601], [8.250, 11.384], [7.707, 11.034], [7.258, 10.570], [6.925, 10.016], [6.925, 5.075], [-0.075, 5.075]]}}
{"command": "roof_create", "args": {"boundary": [[-0.075, -0.075], [12.075, -0.075], [12.075, 10.016], [11.742, 10.570], [11.293, 11.034], [10.750, 11.384], [10.142, 11.601], [9.500, 11.675], [8.858, 11.601], [8.250, 11.384], [7.707, 11.034], [7.258, 10.570], [6.925, 10.016], [6.925, 5.075], [-0.075, 5.075]], "overhang": 0.6, "offset": 3.0}}
{"command": "element_set", "args": {"id": 117, "params": {"shape": {"Hip": {"slope": 0.45}}}}}
// Rooms (their tags show in the plans).
{"command": "room_create", "args": {"point": [2.7, 2.5], "name": "Living room"}}
{"command": "room_create", "args": {"point": [7.2, 2.5], "name": "Kitchen"}}
{"command": "room_create", "args": {"point": [10.5, 2.5], "name": "Bedroom"}}
{"command": "room_create", "args": {"point": [8.5, 9], "name": "Suite"}}
{"command": "room_create", "args": {"point": [10.7, 6.2], "name": "Bathroom"}}
// Concrete frame: columns (123-133) at the corners, beams on top of the walls.
{"command": "column_create", "args": {"position": [0, 0]}}
{"command": "column_create", "args": {"position": [5.5, 0]}}
{"command": "column_create", "args": {"position": [9, 0]}}
{"command": "column_create", "args": {"position": [12, 0]}}
{"command": "column_create", "args": {"position": [0, 5]}}
{"command": "column_create", "args": {"position": [5.5, 5]}}
{"command": "column_create", "args": {"position": [7, 5]}}
{"command": "column_create", "args": {"position": [9, 5]}}
{"command": "column_create", "args": {"position": [12, 5]}}
{"command": "column_create", "args": {"position": [12, 10]}}
{"command": "column_create", "args": {"position": [7, 10]}}
{"command": "elements_phase_set", "args": {"ids": [123, 124, 125, 127, 128, 130], "created": 81}}
{"command": "beams_between_columns", "args": {"columns": [123, 124, 125, 126, 131, 132]}}
{"command": "beams_between_columns", "args": {"columns": [133, 129, 128, 127, 123]}}
{"command": "beams_between_columns", "args": {"columns": [129, 130, 131]}}
{"command": "beams_between_columns", "args": {"columns": [125, 130]}}
{"command": "beams_between_columns", "args": {"columns": [124, 128]}}
{"command": "footings_under_columns", "args": {}}
{"command": "strip_footings_under_walls", "args": {"walls": [90, 91, 92, 93, 96, 97, 98, 99, 100]}}
{"command": "rebar_typical", "args": {}}
{"command": "structure_number", "args": {}}
// A steel pergola over the terrace.
{"command": "floor_create", "args": {"boundary": [[-0.075, -0.075], [5.575, -0.075], [5.575, -3.4], [-0.075, -3.4]], "offset": -0.05}}
{"command": "column_create", "args": {"position": [0.3, -3.1], "type": 16, "height": 2.8}}
{"command": "column_create", "args": {"position": [5.2, -3.1], "type": 16, "height": 2.8}}
{"command": "beams_between_columns", "args": {"columns": [228, 229], "type": 17, "top_offset": 2.8}}
{"command": "beam_create", "args": {"start": [0.3, -3.1], "end": [0.3, -0.075], "type": 17, "top_offset": 2.8}}
{"command": "beam_create", "args": {"start": [2.75, -3.1], "end": [2.75, -0.075], "type": 17, "top_offset": 2.8}}
{"command": "beam_create", "args": {"start": [5.2, -3.1], "end": [5.2, -0.075], "type": 17, "top_offset": 2.8}}
// Furniture.
{"command": "component_place", "args": {"type": 47, "position": [2.8, 4.45]}}
{"command": "component_place", "args": {"type": 44, "position": [7.2, 2.0]}}
{"command": "component_place", "args": {"type": 45, "position": [6.9, 1.35]}}
{"command": "component_place", "args": {"type": 45, "position": [7.5, 1.35]}}
{"command": "component_place", "args": {"type": 45, "position": [6.9, 2.65], "rotation": 180}}
{"command": "component_place", "args": {"type": 45, "position": [7.5, 2.65], "rotation": 180}}
{"command": "component_place", "args": {"type": 46, "position": [10.975, 2.3], "rotation": -90}}
{"command": "component_place", "args": {"type": 50, "position": [10.3, 4.6]}}
{"command": "component_place", "args": {"type": 46, "position": [8.025, 8.8], "rotation": 90}}
// Building services: plumbing fixtures, the distribution board, systems and circuits.
{"command": "component_place", "args": {"type": 48, "position": [11.6, 5.6], "rotation": -90}}
{"command": "component_place", "args": {"type": 49, "position": [11.7, 6.45], "rotation": -90}}
{"command": "component_place", "args": {"type": 51, "position": [10.4, 7.45]}}
{"command": "component_place", "args": {"type": 53, "position": [10.4, 6.9]}}
{"command": "component_place", "args": {"type": 52, "position": [6.4, 4.925]}}
{"command": "component_place", "args": {"type": 58, "position": [8.925, 4.2], "rotation": -90}}
// Circuits 249-251 (the project already has cold water 60, hot water 61 and sanitary 62).
{"command": "system_create", "args": {"kind": "lighting", "name": "Lighting"}}
{"command": "system_create", "args": {"kind": "power", "name": "Outlets"}}
{"command": "system_create", "args": {"kind": "power", "name": "Kitchen and bath outlets"}}
// Lights and switches (lighting circuit), outlets.
{"command": "component_place", "args": {"type": 59, "position": [2.75, 2.5], "system": 249}}
{"command": "component_place", "args": {"type": 59, "position": [7.25, 2.5], "system": 249}}
{"command": "component_place", "args": {"type": 59, "position": [10.5, 2.5], "system": 249}}
{"command": "component_place", "args": {"type": 59, "position": [9.5, 8.7], "system": 249}}
{"command": "component_place", "args": {"type": 59, "position": [10.5, 6.25], "system": 249}}
{"command": "component_place", "args": {"type": 56, "position": [2.4, 0.075], "rotation": 180, "system": 249}}
{"command": "component_place", "args": {"type": 56, "position": [5.55, 4.2], "rotation": 90, "system": 249}}
{"command": "component_place", "args": {"type": 56, "position": [9.075, 1.8], "rotation": 90, "system": 249}}
{"command": "component_place", "args": {"type": 56, "position": [8.75, 5.075], "rotation": 180, "system": 249}}
{"command": "component_place", "args": {"type": 56, "position": [9.55, 7.1], "rotation": 90, "system": 249}}
{"command": "component_place", "args": {"type": 54, "position": [0.075, 1.0], "rotation": 90, "system": 250}}
{"command": "component_place", "args": {"type": 54, "position": [1.2, 4.925], "system": 250}}
{"command": "component_place", "args": {"type": 54, "position": [9.075, 3.5], "rotation": 90, "system": 250}}
{"command": "component_place", "args": {"type": 54, "position": [11.925, 1.0], "rotation": -90, "system": 250}}
{"command": "component_place", "args": {"type": 54, "position": [7.075, 7.0], "rotation": 90, "system": 250}}
{"command": "component_place", "args": {"type": 54, "position": [11.925, 9.0], "rotation": -90, "system": 250}}
{"command": "component_place", "args": {"type": 55, "position": [7.5, 4.925], "system": 251}}
{"command": "component_place", "args": {"type": 55, "position": [8.925, 3.0], "rotation": -90, "system": 251}}
{"command": "component_place", "args": {"type": 55, "position": [5.55, 1.0], "rotation": 90, "system": 251}}
{"command": "component_place", "args": {"type": 55, "position": [11.925, 7.05], "rotation": -90, "system": 251}}
// Conduits from the board, then a branch from every device to them.
{"command": "conduit_create", "args": {"start": [2.75, 2.5], "end": [10.5, 2.5], "circuits": [249, 250, 251]}}
{"command": "conduit_create", "args": {"start": [8.75, 4.2], "end": [8.75, 2.5], "circuits": [249, 250, 251]}}
{"command": "conduit_create", "args": {"start": [10.5, 2.5], "end": [10.5, 8.7], "circuits": [249, 250, 251]}}
{"command": "conduit_create", "args": {"start": [10.5, 8.7], "end": [9.5, 8.7], "circuits": [249, 250]}}
// Water supply in the walls and the drains to the sewer, then branches to the fixtures.
{"command": "pipe_create", "args": {"start": [12.6, 5.0], "end": [6.0, 5.0], "system": 60}}
{"command": "pipe_create", "args": {"start": [11.85, 5.0], "end": [11.85, 7.35], "system": 60}}
{"command": "pipe_create", "args": {"start": [9.8, 6.9], "end": [12.8, 6.9], "system": 62}}
{"command": "pipe_create", "args": {"start": [12.8, 6.9], "end": [12.8, -1.0], "system": 62}}
{"command": "pipe_create", "args": {"start": [6.4, 4.5], "end": [6.4, -1.0], "system": 62}}
{"command": "pipe_create", "args": {"start": [6.4, -1.0], "end": [12.8, -1.0], "system": 62}}
{"command": "pipe_create", "args": {"start": [12.8, -1.0], "end": [13.8, -1.0], "system": 62}}
{"command": "mep_connect", "args": {"elements": [243, 244, 245, 246, 247, 248, 252, 253, 254, 255, 256, 257, 258, 259, 260, 261, 262, 263, 264, 265, 266, 267, 268, 269, 270, 271]}}
{"command": "mep_size_apply", "args": {}}
// Dimensions in the ground floor plan (view 65).
{"command": "dimension_create", "args": {"view": 65, "kind": "linear", "a": [-0.075, -0.075], "b": [-0.075, 5.075], "offset": 1.2}}
{"command": "dimension_create", "args": {"view": 65, "kind": "linear", "a": [12.075, -0.075], "b": [12.075, 10.016], "offset": -1.2}}
{"command": "dimension_create", "args": {"view": 65, "kind": "linear", "a": [-0.075, 5.075], "b": [6.925, 5.075], "offset": 1.0}}
{"command": "dimension_create", "args": {"view": 65, "kind": "radial", "a": [9.5, 8.847], "b": [9.5, 11.675]}}
// Views. The foundations show in the structural views only.
{"command": "view_graphics_set", "args": {"view": 65, "category": "foundation", "visible": false}}
{"command": "view_graphics_set", "args": {"view": 69, "category": "foundation", "visible": false}}
{"command": "view_graphics_set", "args": {"view": 69, "category": "pipe", "visible": false}}
{"command": "view_graphics_set", "args": {"view": 69, "category": "conduit", "visible": false}}
{"command": "view_create", "args": {"kind": "plumbing_plan", "level": 1, "name": "Plumbing", "scale": 100}}
{"command": "view_create", "args": {"kind": "electrical_plan", "level": 1, "name": "Electrical", "scale": 100}}
{"command": "view_create", "args": {"kind": "panel_diagram", "panel": 248, "name": "Board diagram"}}
{"command": "view_create", "args": {"kind": "structural_plan", "level": 1, "name": "Structure", "scale": 100}}
{"command": "view_create", "args": {"kind": "rebar", "name": "Reinforcement"}}
{"command": "view_create", "args": {"kind": "analytical", "name": "Analytical model"}}
{"command": "view_create", "args": {"kind": "section", "start": [10.3, 12.5], "end": [10.3, -4.5], "depth": 11, "name": "Section A"}}
{"command": "view_duplicate", "args": {"view": 65}}
{"command": "view_duplicate", "args": {"view": 65}}
{"command": "view_set", "args": {"view": 333, "phase_filter": 84}}
{"command": "view_set", "args": {"view": 334, "phase_filter": 84}}
{"command": "view_set", "args": {"view": 336, "phase_filter": 84}}
{"command": "view_graphics_set", "args": {"view": 333, "category": "foundation", "visible": false}}
{"command": "view_graphics_set", "args": {"view": 334, "category": "foundation", "visible": false}}
// The ground floor plan and the 3D view show the finished house; a copy shows the renovation.
{"command": "view_set", "args": {"view": 65, "phase_filter": 84, "scale": 100}}
{"command": "view_set", "args": {"view": 69, "phase_filter": 84}}
{"command": "view_set", "args": {"view": 340, "name": "Renovation", "phase_filter": 83, "scale": 100}}
// A view filter (342) colors the partitions in another copy.
{"command": "filter_create", "args": {"name": "Partitions", "categories": ["wall"], "rules": [{"param": "thickness", "op": "less", "value": 0.12}]}}
{"command": "view_set", "args": {"view": 341, "name": "Wall types", "phase_filter": 84, "scale": 100}}
{"command": "view_filter_add", "args": {"view": 341, "filter": 342, "overrides": {"cut_lines": {"color": [200, 90, 20], "weight": 0.5}, "cut_fill": {"pattern": "Solid", "color": [245, 160, 80]}}}}
// Sheet A101: the plan, the section and the 3D view.
{"command": "view_set", "args": {"view": 339, "phase_filter": 84, "scale": 100}}
{"command": "view_set", "args": {"view": 79, "params": {"viewports": [{"view": 65, "center": [115, 160]}, {"view": 69, "center": [310, 128]}]}}}
{"command": "sheet_place_view", "args": {"sheet": 79, "view": 339, "center": [305, 240]}}
// A 3D view (343) from the north-east shows the roof over the arc wall.
{"command": "view_create", "args": {"kind": "three_d", "name": "3D North-east"}}
{"command": "view_set", "args": {"view": 343, "phase_filter": 84, "params": {"camera": {"target": [6.5, 5.0, 1.0], "yaw_deg": 215, "pitch_deg": 25, "distance": 24}}}}
{"command": "view_graphics_set", "args": {"view": 343, "category": "foundation", "visible": false}}
{"command": "view_graphics_set", "args": {"view": 343, "category": "pipe", "visible": false}}
{"command": "view_graphics_set", "args": {"view": 343, "category": "conduit", "visible": false}}
// A second filter (344) fills the exterior walls in the same view.
{"command": "filter_create", "args": {"name": "Exterior walls", "categories": ["wall"], "rules": [{"param": "thickness", "op": "greater", "value": 0.12}]}}
{"command": "view_filter_add", "args": {"view": 341, "filter": 344, "overrides": {"cut_fill": {"pattern": "Solid", "color": [150, 185, 225]}}}}
